#!/usr/bin/env python3
"""Orientation feed for the LookAway Omarchy plugin.

Emits one JSON object per line on stdout:

    {"connected": true, "yaw": 12.3, "pitch": -4.0, "roll": 0.0, "source": "airpods"}

Live mode talks the Apple Accessory Protocol (AAP) to AirPods over Bluetooth
L2CAP PSM 0x1001, starts the head-tracking sensor stream (opcode 0x17), and
decodes the fused orientation triple. The packet layout and the orientation
math are ported from LibrePods' HeadOrientation.kt (via the Linux
pods-head-tracker bridge); yaw/pitch are reported relative to a neutral pose
captured at startup. --demo emits a synthetic sweep for previewing without
earbuds.

Tested target: AirPods Pro 2. Other head-tracking AirPods (3rd gen +, Pro,
Max) use the same channel and layout.
"""

import argparse
import json
import math
import os
import socket
import struct
import subprocess
import sys
import time

# --- AAP / L2CAP constants ----------------------------------------------------
AACP_PSM = 0x1001
SOL_BLUETOOTH = 274
BT_SECURITY = 4
BT_SECURITY_MEDIUM = 2

HANDSHAKE = bytes.fromhex("00000400010002000000000000000000")
FEATURE_FLAGS = bytes.fromhex("040004004D00D70000000000000000")
NOTIFICATIONS = bytes.fromhex("040004000F00FFFFFFFF")

# Head-tracking start packets. ALT is the variant that streamed on hardware
# per pods-head-tracker; DEF is the variant LibrePods/librepods-rs send. We try
# ALT first and fall back to DEF if no sensor packets arrive.
START_ALT = bytes([0x04, 0x00, 0x04, 0x00, 0x17, 0x00, 0x00, 0x00, 0x10, 0x00, 0x0F, 0x00,
                   0x08, 0x73, 0x42, 0x0B, 0x08, 0x10, 0x10, 0x02, 0x1A, 0x05, 0x01, 0x40,
                   0x9C, 0x00, 0x00])
START_DEF = bytes([0x04, 0x00, 0x04, 0x00, 0x17, 0x00, 0x00, 0x00, 0x10, 0x00, 0x10, 0x00,
                   0x08, 0xA1, 0x02, 0x42, 0x0B, 0x08, 0x0E, 0x10, 0x02, 0x1A, 0x05, 0x01,
                   0x40, 0x9C, 0x00, 0x00])

HT_PREFIX = bytes([0x04, 0x00, 0x04, 0x00, 0x17, 0x00, 0x00, 0x00, 0x10, 0x00])
HT_MIN = 70

# Ear-detection notification: prefix, then two pod states (0x00 in ear, 0x01
# out of ear, 0x02 in case). Bytes are primary/secondary, not left/right, so
# only "any byte is 0x00" is meaningful.
EAR_PREFIX = bytes.fromhex("040004000600")

# Orientation triple offsets within the sensor packet, and the raw full scale.
OFF_O1, OFF_O2, OFF_O3 = 43, 45, 47
OFF_HACC, OFF_VACC = 51, 53
FULL_SCALE = 32000.0

CALIB_N = 10
CALIB_STILL_MAX = 800
CALIB_MAX_TRIES = 6
START_RETRY_SECS = 4.0
RECONNECT_SECS = 3.0
NO_AIRPODS_SECS = 15.0


def emit(payload):
    sys.stdout.write(json.dumps(payload) + "\n")
    sys.stdout.flush()


def log(message):
    sys.stderr.write(f"lookaway-sensor: {message}\n")
    sys.stderr.flush()


def s16(packet, off):
    return struct.unpack_from("<h", packet, off)[0]


def wrap_s16(delta):
    """Wrap an int16 difference back into [-32768, 32768)."""
    return (delta + 32768.0) % 65536.0 - 32768.0


def is_head_tracking(packet):
    return (len(packet) >= HT_MIN and packet[:10] == HT_PREFIX
            and packet[10] in (0x44, 0x45) and packet[11] == 0)


def decode_ear(packet):
    """Return the two raw pod states, or None if this is not an ear packet."""
    if len(packet) < 8 or packet[:6] != EAR_PREFIX:
        return None
    return packet[6], packet[7]


def median(values):
    ordered = sorted(values)
    return ordered[len(ordered) // 2]


class Calibrator:
    """Neutral-pose capture: median of consecutive still samples.

    Folds samples into wrap-safe deltas from the batch's first sample and
    reduces by median, so a raw origin near the +/-32768 seam cannot skew the
    result. A batch that moves too much is retried up to CALIB_MAX_TRIES
    times, then accepted anyway so a fidgety start can only delay tracking.
    """

    def __init__(self):
        self.ref = None
        self.samples = []
        self.tries = 0

    def feed(self, *vals):
        if self.ref is None:
            self.ref = vals
        self.samples.append(tuple(wrap_s16(v - r) for v, r in zip(vals, self.ref)))
        if len(self.samples) < CALIB_N:
            return None
        axes = list(zip(*self.samples))
        spread = max(max(a) - min(a) for a in axes)
        if spread > CALIB_STILL_MAX and self.tries < CALIB_MAX_TRIES:
            self.tries += 1
            self.ref, self.samples = None, []
            log("moving during calibration - holding still, face forward")
            return None
        return tuple(r + median(a) for r, a in zip(self.ref, axes))


def decode_orientation(packet, neutral):
    o1, o2, o3 = s16(packet, OFF_O1), s16(packet, OFF_O2), s16(packet, OFF_O3)
    hacc, vacc = s16(packet, OFF_HACC), s16(packet, OFF_VACC)
    o1n = wrap_s16(o1 - neutral[0])
    o2n = wrap_s16(o2 - neutral[1])
    o3n = wrap_s16(o3 - neutral[2])
    pitch = (o2n + o3n) / 2.0 / FULL_SCALE * 180.0
    yaw = (o2n - o3n) / 2.0 / FULL_SCALE * 180.0
    roll = (o1n - (o2n + o3n) / 2.0) / 2.0 / FULL_SCALE * 180.0
    return {
        "yaw": round(yaw, 3),
        "pitch": round(pitch, 3),
        "roll": round(roll, 3),
        "hacc": hacc,
        "vacc": vacc,
    }


def find_airpods():
    """Return the MAC of a paired/known AirPods, or None."""
    override = os.environ.get("LOOKAWAY_AIRPODS_MAC")
    if override:
        return override
    try:
        out = subprocess.run(["bluetoothctl", "devices"], capture_output=True,
                             text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError) as error:
        log(f"bluetoothctl unavailable: {error}")
        return None
    for line in out.splitlines():
        parts = line.split(" ", 2)
        if len(parts) == 3 and parts[0] == "Device" and "airpods" in parts[2].lower():
            return parts[1]
    return None


def is_connected(mac):
    """True when BlueZ reports the device as connected."""
    try:
        out = subprocess.run(["bluetoothctl", "info", mac], capture_output=True,
                             text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    for line in out.splitlines():
        if line.strip().startswith("Connected:"):
            return "yes" in line.lower()
    return False


def open_l2cap(mac):
    sock = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_SEQPACKET, socket.BTPROTO_L2CAP)
    sock.setsockopt(SOL_BLUETOOTH, BT_SECURITY, struct.pack("BB", BT_SECURITY_MEDIUM, 0))
    sock.settimeout(2.0)
    sock.connect((mac, AACP_PSM))
    return sock


def handshake(sock):
    sock.send(HANDSHAKE)
    time.sleep(0.2)
    sock.send(FEATURE_FLAGS)
    time.sleep(0.2)
    sock.send(NOTIFICATIONS)
    time.sleep(0.2)


def stream(mac, start_mode, probe):
    starts = {"alt": [("ALT", START_ALT)], "def": [("DEF", START_DEF)],
              "auto": [("ALT", START_ALT), ("DEF", START_DEF)]}[start_mode]
    sock = open_l2cap(mac)
    try:
        log(f"L2CAP channel open to {mac}")
        handshake(sock)
        pump(sock, starts, probe)
    finally:
        try:
            sock.close()
        except OSError:
            pass


def pump(sock, starts, probe):
    start_index = 0
    sock.send(starts[start_index][1])
    last_start = time.monotonic()
    neutral = None
    calib = Calibrator()
    in_ear = None
    paused = False

    while True:
        try:
            packet = sock.recv(2048)
        except socket.timeout:
            packet = None

        now = time.monotonic()

        if packet is None:
            # No data: if head tracking never started, try the other variant.
            if neutral is None and len(starts) > 1 and now - last_start >= START_RETRY_SECS:
                start_index = (start_index + 1) % len(starts)
                sock.send(starts[start_index][1])
                last_start = now
                log(f"no sensor data - trying start variant {starts[start_index][0]}")
            continue

        if not is_head_tracking(packet):
            ear = decode_ear(packet)
            if ear is not None:
                was, in_ear = in_ear, (0x00 in ear)
                if in_ear is False:
                    # Both buds out: the pull itself is motion, and the sensor
                    # seat changes when they go back in, so drop the neutral.
                    paused = True
                    neutral, calib = None, Calibrator()
                    emit({"connected": False, "source": "airpods", "phase": "paused"})
                elif was is False:
                    # Back in the ears: capture a fresh neutral.
                    paused = False
                    neutral, calib = None, Calibrator()
                    log("buds back in ear - recalibrating")
                    emit({"connected": False, "source": "airpods", "phase": "calibrating"})
                continue
            if probe:
                op = packet[4] if len(packet) > 4 else -1
                log(f"rx op=0x{op:02x} len={len(packet)}")
            continue

        if paused:
            continue

        if neutral is None:
            if probe:
                log(f"HT o=({s16(packet, OFF_O1)},{s16(packet, OFF_O2)},{s16(packet, OFF_O3)})")
            neutral = calib.feed(s16(packet, OFF_O1), s16(packet, OFF_O2), s16(packet, OFF_O3))
            if neutral is not None:
                log(f"calibrated neutral={tuple(round(n) for n in neutral)}")
                emit({"connected": True, "ready": True, "recal": True, "source": "airpods",
                      "yaw": 0.0, "pitch": 0.0, "roll": 0.0})
            else:
                emit({"connected": False, "source": "airpods", "phase": "calibrating"})
            continue

        sample = decode_orientation(packet, neutral)
        sample.update({"connected": True, "ready": True, "source": "airpods"})
        emit(sample)


def run_live(args):
    last_missing_log = 0.0
    while True:
        mac = args.mac or find_airpods()
        # Don't hammer the L2CAP connect while the buds are paired but off.
        if not mac or not is_connected(mac):
            emit({"connected": False, "source": "airpods",
                  "phase": "waiting" if mac else "no-airpods"})
            now = time.monotonic()
            if now - last_missing_log > NO_AIRPODS_SECS:
                last_missing_log = now
                log("waiting for AirPods" if mac else
                    "no AirPods found; pair them (bluetoothctl) or pass --mac")
            time.sleep(NO_AIRPODS_SECS)
            continue
        try:
            emit({"connected": False, "source": "airpods", "phase": "connecting"})
            stream(mac, args.start, args.probe)
        except Exception as error:
            log(f"link error ({error}); reconnecting in {RECONNECT_SECS:.0f}s")
            emit({"connected": False, "source": "airpods", "error": str(error)})
            time.sleep(RECONNECT_SECS)


def run_demo(args):
    rate = max(1.0, args.rate)
    dt = 1.0 / rate
    start = time.time()
    while True:
        t = time.time() - start
        yaw = args.amplitude * math.sin(2 * math.pi * t / args.period)
        pitch = args.amplitude * 0.3 * math.sin(2 * math.pi * t / (args.period * 1.7) + 0.6)
        emit({
            "connected": True,
            "ready": True,
            "source": "demo",
            "yaw": round(yaw, 3),
            "pitch": round(pitch, 3),
            "roll": 0.0,
            "t": round(t, 3),
        })
        time.sleep(dt)


def selftest():
    assert wrap_s16(32768) == -32768
    assert wrap_s16(-32769) == 32767
    assert wrap_s16(10 - 20) == -10
    packet = bytearray(HT_MIN)
    packet[0:10] = HT_PREFIX
    packet[10] = 0x44
    packet[11] = 0x00

    def put(pkt, off, value):
        pkt[off:off + 2] = struct.pack("<h", value)

    # o2 == o3 == +16000 with a zero neutral => pitch 90, yaw 0.
    put(packet, OFF_O2, 16000)
    put(packet, OFF_O3, 16000)
    assert is_head_tracking(bytes(packet))
    out = decode_orientation(bytes(packet), (0, 0, 0))
    assert abs(out["pitch"] - 90.0) < 0.001, out
    assert abs(out["yaw"]) < 0.001, out

    # o2 == +32000, o3 == -32000 => yaw 180, pitch 0.
    put(packet, OFF_O2, 32000)
    put(packet, OFF_O3, -32000)
    out = decode_orientation(bytes(packet), (0, 0, 0))
    assert abs(out["yaw"] - 180.0) < 0.001, out
    assert abs(out["pitch"]) < 0.001, out

    # A constant batch calibrates to that value.
    calib = Calibrator()
    for _ in range(CALIB_N):
        neutral = calib.feed(100, 200, 300)
    assert neutral == (100, 200, 300), neutral

    # Ear packets decode; head-tracking packets do not.
    ear = bytearray(EAR_PREFIX + bytes([0x00, 0x01]))
    assert decode_ear(bytes(ear)) == (0x00, 0x01)
    assert decode_ear(bytes(packet)) is None

    print("selftest OK")


def parse_args():
    parser = argparse.ArgumentParser(description="LookAway orientation feed")
    parser.add_argument("--demo", action="store_true", help="synthetic orientation sweep")
    parser.add_argument("--rate", type=float, default=30.0, help="demo samples per second")
    parser.add_argument("--amplitude", type=float, default=40.0, help="demo peak yaw in degrees")
    parser.add_argument("--period", type=float, default=16.0, help="demo sweep period in seconds")
    parser.add_argument("--mac", default=None, help="AirPods MAC (else auto-detect / env)")
    parser.add_argument("--start", choices=["auto", "alt", "def"], default="auto",
                        help="head-tracking start variant")
    parser.add_argument("--probe", action="store_true", help="log raw packets to stderr")
    parser.add_argument("--selftest", action="store_true", help="run decode self-tests and exit")
    return parser.parse_args()


def main():
    args = parse_args()
    if args.selftest:
        selftest()
    elif args.demo:
        run_demo(args)
    else:
        run_live(args)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(0)
